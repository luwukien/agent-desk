<Window x:Class="AgentDesk.Spike.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AgentDesk — Terminal spike" Width="1100" Height="720" MinWidth="700" MinHeight="400"
 Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
 <DockPanel Margin="8">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="AgentDesk · Bản thử terminal" FontSize="20" Margin="0,0,0,8" />
   <DockPanel Margin="0,0,0,6">
    <TextBlock Text="Thư mục: " VerticalAlignment="Center" />
    <TextBox x:Name="FolderBox" />
   </DockPanel>
   <WrapPanel Margin="0,0,0,6">
    <Button Content="+ PowerShell" Click="OnAdd" Padding="10,5" Margin="0,0,8,0" />
    <Button Content="Copy vùng chọn" Click="OnCopy" Focusable="False" Padding="10,5" Margin="0,0,8,0" />
    <Button Content="Paste một dòng" Click="OnPaste" Focusable="False" Padding="10,5" Margin="0,0,8,0" />
    <Button Content="Ngắt (Ctrl+C)" Click="OnInterrupt" Focusable="False" Padding="10,5" Margin="0,0,8,0" />
    <Button Content="Đóng tab" Click="OnCloseTab" Padding="10,5" />
   </WrapPanel>
   <!-- Only headers live in this TabControl. Terminal views stay mounted in TerminalHost. -->
   <TabControl x:Name="Tabs" SelectionChanged="OnSelectionChanged" Height="32" />
  </StackPanel>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" />
  <Grid x:Name="TerminalHost" Background="#171717" />
 </DockPanel>
</Window>
